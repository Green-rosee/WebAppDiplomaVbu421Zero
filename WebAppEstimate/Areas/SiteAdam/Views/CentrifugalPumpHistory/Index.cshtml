<!-- model WebAppEstimate.Areas.SiteAdam.Data.Entity -->

@model List<PumpCentrifugalHistory>
@{
    ViewData["Title"] = "История расчетов Центробежных Насосов:";
}

<h1>Index-> Вывод сохраненых Центробежных Насосов...</h1>
<br/>

<div class="container my-5">

    <h2 class="mb-4">История расчетов центробежных насосов</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <table class="table table-striped table-bordered">
        <thead>
        <tr>
            <th>Наименование ремонтируемого насосного агрегата.</th>
            <th>Количество.</th>
            <th>Стоимость часа,уе.</th>
            <th>Сумма часов,трудоемкость.</th>
            <th>Общая стоимость,уе.</th>
            <th>Дата.</th>
        </tr>
        </thead>

        <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name (учтено Крылатка @item.Impeller мм, Производительность @item.Volume м3/ч,Масса @item.Weight кг)</td>

                <td>@item.Number</td>

                <td>@item.CostHour</td>

                <td>@item.TotalSumHour</td>

                <td>@item.TotalSumCostHour</td>

                <td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
            </tr>
        }

        </tbody>
    </table>

</div>

