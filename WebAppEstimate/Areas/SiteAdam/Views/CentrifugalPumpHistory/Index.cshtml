<!-- страница вывода расчета даных из формы -->

@model List<PumpCentrifugalHistory>
@{
    ViewData["Title"] = "История расчетов Центробежных Насосов:";
}

<h3>Вывод сохраненых Центробежных Насосов...</h3>
<br/>

<div class="container my-5">

    <h2 class="mb-4">История расчетов центробежных насосов</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Блок для кнопок -->
    <div class="d-flex gap-2 mb-4">

        <a asp-area="SiteAdam"
           asp-controller="CentrifugalPumpHistory"
           asp-action="Index"
           class="btn btn-success">
            Обновить список
        </a>

        <a href="/SiteAdam/Excel"
           target="_blank"
           rel="noopener"
           class="btn btn-success">
            Открыть Excel таблицу
        </a>
        
        <a asp-area="SiteAdam"
           asp-controller="CentrifugalPump"
           asp-action="Calculate"
           target="_blank"
           rel="noopener"
           class="btn btn-primary">
            Новый расчет
        </a>

        <form asp-area="SiteAdam"
              asp-controller="CentrifugalPumpHistory"
              asp-action="DeleteAll"
              method="post"
              onsubmit="return confirm('Вы действительно хотите удалить ВСЮ историю расчетов?');">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-danger">
                Удалить всю историю
            </button>
        </form>

    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            История расчетов пока пуста.
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered align-middle">
            <thead>
            <tr>
                <th>Наименование ремонтируемого насосного агрегата.</th>
                <th>Количество.</th>
                <th>Стоимость часа,уе.</th>
                <th>Сумма часов,трудоемкость.</th>
                <th>Общая стоимость,уе.</th>
                <th>Дата.</th>
                <th>Действие.</th>
            </tr>
            </thead>

            <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>@item.Name</strong>
                        <br/>
                        <small>
                            Крылатка: @item.Impeller мм
                            <br/>
                            Производительность: @item.Volume м³/ч
                            <br/>
                            Масса: @item.Weight кг
                        </small>
                    </td>

                    <td>@item.Number</td>

                    <td>@item.CostHour</td>

                    <td>@item.TotalSumHour</td>

                    <td>@item.TotalSumCostHour</td>

                    <td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </td>

                    <td>
                        <form asp-area="SiteAdam"
                              asp-controller="CentrifugalPumpHistory"
                              asp-action="Delete"
                              method="post"
                              onsubmit="return confirm('Удалить выбранный расчет?');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id"/>

                            <button type="submit"
                                    class="btn btn-sm btn-danger">
                                Удалить
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }

</div>

