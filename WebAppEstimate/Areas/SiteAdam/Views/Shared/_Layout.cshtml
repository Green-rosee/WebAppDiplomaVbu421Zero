<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["HomeIndex"] - WebAppEstimate</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/WebAppEstimate.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <!-- Ссылка на главный корень приложения -->
            <a class="navbar-brand fw-bold text-secondary" asp-area="" asp-controller="Home" asp-action="Index">⚓
                Судоверфь</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <span class="nav-link text-muted">Раздел: SiteAdam</span>
                    </li>
                </ul>

                <!-- ДИНАМИЧЕСКИЙ БЛОК АВТОРИЗАЦИИ В ШАПКЕ -->
                <ul class="navbar-nav">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item d-flex align-items-center">
                            <span class="nav-link text-dark me-2">Привет, <strong>@User.Identity.Name</strong>!</span>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-sm btn-outline-danger" asp-area="" asp-controller="Account"
                               asp-action="AccountLoginOut">Выйти</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-sm btn-primary" asp-area="" asp-controller="Account" asp-action="Account">Войти</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted bg-light py-3 mt-auto">
    <div class="container text-center">
        &copy; 2026 - WebAppEstimate - Сметный расчет судоремонта
        <!-- Секция Footer оставлена пустой и безопасной, чтобы не вызывать ошибок -->
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>


