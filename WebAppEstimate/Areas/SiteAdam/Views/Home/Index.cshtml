@{
    ViewData["HomeIndex"] = "Index";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <h1 class="display-4 text-uppercase font-weight-bold" style="letter-spacing: 1px;">Расчет Насосов</h1>
        <p class="text-muted lead">Выберите тип судового оборудования для составления сметы</p>
        <span class="badge bg-secondary p-2 text-uppercase" style="font-size: 0.8rem; letter-spacing: 1px;">Область: SiteAdam</span>
    </div>

    <!-- АСКЕТИЧНЫЙ БЛОК ССЫЛОК НА РАСЧЕТ НАСОСОВ -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-10 col-lg-8">
            <div class="list-group list-group-flush shadow-sm rounded border">

                <!-- Насос 1 -->
                <a asp-area="SiteAdam" asp-controller="Home" asp-action="AboutCentrifugalPump"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                    <div class="d-flex align-items-center">
                        <span class="me-3 text-secondary" style="font-size: 1.2rem;">01.</span>
                        <span class="fw-semibold text-dark">Центробежный насос</span>
                    </div>
                    <span class="text-muted small">Расчет стоимости ремонта &rarr;</span>
                </a>

                <!-- Насос 2 -->
                <a asp-area="SiteAdam" asp-controller="" asp-action=""
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                    <div class="d-flex align-items-center">
                        <span class="me-3 text-secondary" style="font-size: 1.2rem;">02.</span>
                        <span class="fw-semibold text-dark">Шестеренчатый насос</span>
                    </div>
                    <span class="text-muted small">Расчет стоимости ремонта &rarr;</span>
                </a>

                <!-- Насос 3 -->
                <a asp-area="SiteAdam" asp-controller="" asp-action=""
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                    <div class="d-flex align-items-center">
                        <span class="me-3 text-secondary" style="font-size: 1.2rem;">03.</span>
                        <span class="fw-semibold text-dark">Винтовой насос</span>
                    </div>
                    <span class="text-muted small">Расчет стоимости ремонта &rarr;</span>
                </a>

                <!-- Насос 4 -->
                <a asp-area="SiteAdam" asp-controller="" asp-action=""
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                    <div class="d-flex align-items-center">
                        <span class="me-3 text-secondary" style="font-size: 1.2rem;">04.</span>
                        <span class="fw-semibold text-dark">Поршневой насос</span>
                    </div>
                    <span class="text-muted small">Расчет стоимости ремонта &rarr;</span>
                </a>

                <!-- Насос 5 -->
                <a asp-area="SiteAdam" asp-controller="" asp-action=""
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                    <div class="d-flex align-items-center">
                        <span class="me-3 text-secondary" style="font-size: 1.2rem;">05.</span>
                        <span class="fw-semibold text-dark">Все типы Насосов:</span>
                    </div>
                    <span class="text-muted small">Расчет стоимости ремонта &rarr;</span>
                </a>

            </div>
        </div>
    </div>

    <!-- Вспомогательная панель авторизации (аккуратные кнопки сверху/снизу) -->
    <div class="d-flex justify-content-center gap-3 border-top pt-4">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <span class="text-muted align-self-center">Вы вошли как: <strong>@User.Identity.Name</strong></span>
            <a class="btn btn-sm btn-outline-danger" asp-area="" asp-controller="Account" asp-action="AccountLoginOut">Выйти</a>
        }
        else
        {
            <a class="btn btn-sm btn-outline-secondary" asp-area="" asp-controller="Account" asp-action="Account">Авторизация</a>
        }
    </div>
</div>



<div class="text-center text-muted small py-3">
    ...Идет разработка приложения... На этой страницы расположены вход для расчета 5-ти форм для расчета Насосов...
    ...Центробежный...Шестеренчатый...Винтовой...Поршневой...
</div>




