
@model WebAppEstimate.Areas.SiteAdam.Models.CentrifugalPumpModel

@{
    ViewData["HomeIndex"] = "Расчет центробежного насоса";
}

<h1>CentrifugalPumpForm</h1>
<br/>

<div class="container my-5">
    <!-- Кнопка назад -->
    <div class="mb-4">
        <a asp-area="SiteAdam" asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none small">
            &larr; Вернуться к выбору насосов
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <!-- Заголовок формы -->
            <div class="border-bottom pb-3 mb-4">
                <h2 class="h4 text-uppercase font-weight-bold style-title" style="letter-spacing: 0.5px;">
                    Параметры центробежного насоса.
                </h2>
                <p class="text-muted small mb-0">Заполните спецификацию для проведения сметного расчета</p>
            </div>

            <!-- Уведомление об успешном расчете -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show small" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Аскетичная форма (Связываем с контроллером PumpCalculation) -->
            <form asp-area="SiteAdam" asp-controller="CentrifugalPump" asp-action="Calculate" method="post"
                  class="needs-validation">

                @*@Html.AntiForgeryToken()--возможно пригодиться *@

                <!-- 0. Стоимость за час работы -->
                <div class="mb-3">
                    <label asp-for="CostHour" class="form-label fw-semibold text-secondary small">Стоимость Часа
                        Работы.</label>
                    <input asp-for="CostHour" class="form-control form-control-sm border-secondary-subtle"
                           placeholder="Например, 600 руб/час"/>
                    <span asp-validation-for="CostHour" class="text-danger small d-block mt-1"></span>
                </div>

                <!-- 1. Название насоса -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold text-secondary small">NamePump</label>
                    <input asp-for="Name" class="form-control form-control-sm border-secondary-subtle"
                           placeholder="Например, Wa 100-200"/>
                    <span asp-validation-for="Name" class="text-danger small d-block mt-1"></span>
                </div>


                <!-- 2. Выбор серии  -->
                <div class="mb-3">
                    <label asp-for="SelectedSeriesId" class="form-label fw-semibold text-secondary small">Серия
                        оборудования</label>
                    <select asp-for="SelectedSeriesId" asp-items="Model.SeriesOptions"
                            class="form-select form-select-sm border-secondary-subtle">
                        <option value="">-- Выберите серию из реестра --</option>
                    </select>
                    <span asp-validation-for="SelectedSeriesId" class="text-danger small d-block mt-1"></span>
                </div>


                <!-- Блок числовых характеристик и количества ед. -->
                <div class="row g-3 mb-4">
                    <!-- 3. Impeller -->
                    <div class="col-sm-3">
                        <label asp-for="Impeller" class="form-label fw-semibold text-secondary small">Крыльчатка,
                            мм.</label>
                        <input asp-for="Impeller" type="number" step="1"
                               class="form-control form-control-sm border-secondary-subtle" placeholder="0"/>
                        <span asp-validation-for="Impeller" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- 4. Weight -->
                    <div class="col-sm-3">
                        <label asp-for="Weight" class="form-label fw-semibold text-secondary small">Масса, кг.</label>
                        <input asp-for="Weight" type="number" step="1"
                               class="form-control form-control-sm border-secondary-subtle" placeholder="0"/>
                        <span asp-validation-for="Weight" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- 5. Volume -->
                    <div class="col-sm-3">
                        <label asp-for="Volume" class="form-label fw-semibold text-secondary small">Объем, л.</label>
                        <input asp-for="Volume" type="number" step="1"
                               class="form-control form-control-sm border-secondary-subtle" placeholder="0"/>
                        <span asp-validation-for="Volume" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- 0. Number Unit Pumps (Перенесли в сетку) -->
                    <div class="col-sm-3">
                        <label asp-for="Number" class="form-label fw-semibold text-secondary small">Кол-во ед.</label>
                        <input asp-for="Number" type="number"
                               class="form-control form-control-sm border-secondary-subtle" placeholder="1"
                               value="@(Model?.Number ?? 1)"/>
                        <span asp-validation-for="Number" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>

                <!-- Кнопка отправки -->
                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-sm btn-dark text-uppercase py-2 fw-bold"
                            style="letter-spacing: 1px;">
                        Рассчитать калькуляцию...
                    </button>
                </div>

                <!-- Кнопка сохранить в БД 
                <div class="d-grid mt-3">
                    <button type="submit" class="btn btn-sm btn-success text-uppercase py-2 fw-bold"
                            style="letter-spacing: 1px;">
                        Сохранить калькуляцию...
                    </button>
                </div>-->

                <!-- Кнопка отправки на новую Страницу сохраненые данные из БД 
                <div class="d-grid mt-3">
                    <button type="submit" class="btn btn-sm btn-secondary text-uppercase py-2 fw-bold"
                            style="letter-spacing: 1px;">
                        Вывести калькуляцию...
                    </button>
                </div>-->

            </form>

            <!--                           Кнопка сохранить в БД                 -->

            @if (Model != null && Model.IsCalculated)
            {
                <form asp-area="SiteAdam"
                      asp-controller="CentrifugalPumpHistory"
                      asp-action="Save"
                      method="post">

                    <input type="hidden" asp-for="Name"/>
                    <input type="hidden" asp-for="SelectedSeriesId"/>

                    <input type="hidden" asp-for="Impeller"/>
                    <input type="hidden" asp-for="Weight"/>
                    <input type="hidden" asp-for="Volume"/>

                    <input type="hidden" asp-for="Number"/>

                    <input type="hidden" asp-for="CostHour"/>

                    <input type="hidden" asp-for="TotalSumHour"/>
                    <input type="hidden" asp-for="TotalSumCostHour"/>
                    <div class="d-grid mt-3">

                        <button type="submit" class="btn btn-sm btn-success text-uppercase py-2 fw-bold"
                                style="letter-spacing: 1px;">
                            Сохранить калькуляцию...
                        </button>
                    </div>
                </form>
            }


            <!-- Кнопка отправки на новую Страницу сохраненые данные из БД -->
            <div class="d-grid mt-3">
                <a asp-area="SiteAdam"
                   asp-controller="CentrifugalPumpHistory"
                   asp-action="Index"

                   target="_blank"
                   rel="noopener"

                   class="btn btn-sm btn-secondary text-uppercase py-2 fw-bold"
                   style="letter-spacing: 1px;">
                    Вывести калькуляцию...
                </a>
            </div>

            <!-- Блок вывода Калькуляции (Рендерится внутри колонки формы для сохранения сетки) -->
            @if (Model != null && Model.IsCalculated)
            {
                <div class="card mt-4 border-secondary shadow-sm bg-light">
                    <div class="card-header bg-dark text-white py-2">
                        <h6 class="mb-0 text-uppercase small" style="letter-spacing: 0.5px;">
                            Расчет спецификации: <span class="text-warning">@Model.Name</span>
                        </h6>
                    </div>
                    <div class="card-body p-3 small">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Разборка/Сборка (часы)...:</span>
                            <span class="fw-bold text-dark">@Model.HourImpeller ч.</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Демонтаж/Монтаж (часы):</span>
                            <span class="fw-bold text-dark">@Model.HourWeight ч.</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Испытания/Сдача в Работе (часы):</span>
                            <span class="fw-bold text-dark">@Model.HourVolume ч.</span>
                        </div>

                        <hr class="my-2 border-secondary-subtle"/>

                        <div class="d-flex justify-content-between mb-2 text-secondary">
                            <span>Количество оборудования в форме:</span>
                            <span>@Model.Number шт.</span>
                        </div>

                        <div
                            class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary-subtle">
                            <span class="fw-bold text-secondary text-uppercase">Итоговая сумма часов:</span>
                            <span class="h5 mb-0 fw-bold text-success">@Model.TotalSumHour ч.</span>
                        </div>

                        <div
                            class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary-subtle">
                            <span class="fw-bold text-secondary text-uppercase">Итоговая стоимость:</span>
                            <span class="h5 mb-0 fw-bold text-success">@Model.TotalSumCostHour y.е.</span>
                        </div>


                    </div>
                </div>
            }

        </div>
    </div>
</div>


