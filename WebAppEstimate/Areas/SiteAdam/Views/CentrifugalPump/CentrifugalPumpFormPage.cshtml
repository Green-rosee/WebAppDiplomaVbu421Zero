@model WebAppEstimate.Areas.SiteAdam.Models.CentrifugalPumpModel
@{
    ViewData["HomeIndex"] = "Расчет центробежного насоса";
}

<h1>CentrifugalPumpFormPage</h1>

<div class="container my-5">
    <!-- Кнопка назад -->
    <div class="mb-4">
        <a asp-area="SiteAdam" asp-controller="" asp-action="" class="text-muted text-decoration-none small">
            &larr; Вернуться к выбору насосов
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <!-- Заголовок формы -->
            <div class="border-bottom pb-3 mb-4">
                <h2 class="h4 text-uppercase font-weight-bold style-title" style="letter-spacing: 0.5px;">
                    Параметры центробежного насоса
                </h2>
                <p class="text-muted small mb-0">Заполните спецификацию для проведения сметного расчета</p>
            </div>

            <!-- Уведомление об успешном расчете -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show small" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Аскетичная форма -->
            <form asp-area="SiteAdam" asp-controller="" asp-action="" method="post" class="needs-validation">
                <!-- 0. Number Unit Pumps -->
                <div class="col-sm-2">
                    <label class="form-label fw-semibold text-secondary small">Количество едениц.</label>
                    <input a type="number" step="1" class="form-control form-control-sm border-secondary-subtle"
                           placeholder="0.00"/>
                    <span class="text-danger small d-block mt-1"></span>
                </div>

                <!-- 1. Название насоса -->
                <div class="mb-3">
                    <!--  -->
                    <label class="form-label fw-semibold text-secondary small">Название Насоса.</label>
                    <input class="form-content form-control form-control-sm border-secondary-subtle"
                           placeholder="Например, ЦН 100/200"/>
                    <span a class="text-danger small d-block mt-1"></span>
                </div>

                <!-- 2. Выбор серии -->
                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small"></label>

                    <!-- Проверяем, передана ли модель и есть ли в ней опции -->
                    @if (Model != null && Model.SeriesOptions != null)
                    {
                        <select class="form-select form-select-sm border-secondary-subtle">
                            <option value="">-- Выберите серию из реестра --</option>
                        </select>
                    }
                    else
                    {
                        <!-- Если модели нет, показываем пустой заблокированный список, чтобы не было ошибки -->
                        <select class="form-select form-select-sm border-secondary-subtle" disabled>
                            <option value="">-- Список серий пуст или недоступен --</option>
                        </select>
                    }
                    <span class="text-danger small d-block mt-1"></span>
                </div>

                <!-- Блок числовых характеристик в строку для экономии места -->
                <div class="row g-3 mb-4">
                    <!-- 3. Impeller -->
                    <div class="col-sm-4">
                        <label class="form-label fw-semibold text-secondary small">Диаметр Крылатки мм.</label>
                        <input a type="number" step="10" class="form-control form-control-sm border-secondary-subtle"
                               placeholder="0.00"/>
                        <span class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- 4. Weight -->
                    <div class="col-sm-4">
                        <label class="form-label fw-semibold text-secondary small">Масса кг.</label>
                        <input type="number" step="10" class="form-control form-control-sm border-secondary-subtle"
                               placeholder="0.0"/>
                        <span class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- 5. Volume -->
                    <div class="col-sm-4">
                        <label class="form-label fw-semibold text-secondary small">Производительность м3/ч.</label>
                        <input type="number" step="10" class="form-control form-control-sm border-secondary-subtle"
                               placeholder="0.00"/>
                        <span class="text-danger small d-block mt-1"></span>
                    </div>
                </div>

                <!-- Кнопка отправки -->
                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-sm btn-dark text-uppercase py-2 fw-bold"
                            style="letter-spacing: 1px;">
                        Рассчитать спецификацию
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<br/>
<p>...Сдесь будет временый вывод расчета Калькуляции...</p>
@if (Model != null && Model.IsCalculated)
{
    <div class="card mt-4 border-secondary shadow-sm bg-light">
        <div class="card-header bg-dark text-white py-2">
            <h6 class="mb-0 text-uppercase small" style="letter-spacing: 0.5px;">
                Расчет спецификации: <span class="text-warning">@Model.Name</span>
            </h6>
        </div>
        <div class="card-body p-3 small">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Ближайшее колесо (часы):</span>
                <span class="fw-bold text-dark">@Model.HourImpeller ч.</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Ближайший вес (часы):</span>
                <span class="fw-bold text-dark">@Model.HourWeight ч.</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Ближайший объем (часы):</span>
                <span class="fw-bold text-dark">@Model.HourVolume ч.</span>
            </div>

            <hr class="my-2 border-secondary-subtle"/>

            <!-- Показываем количество для прозрачности расчета -->
            <div class="d-flex justify-content-between mb-2 text-secondary">
                <span>Количество оборудования в форме:</span>
                <span>@Model.Number шт.</span>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary-subtle">
                <span class="fw-bold text-secondary text-uppercase">Итоговая сумма часов:</span>
                @* Выводим умноженную сумму TotalSumHour *@
                <span class="h5 mb-0 fw-bold text-success">@Model.TotalSumHour ч.</span>
            </div>
        </div>
    </div>
}

