
@page "/SiteAdam/Excel"
@rendermode InteractiveServer

@using Syncfusion.Blazor.Spreadsheet

@using WebAppEstimate.Areas.SiteAdam.Services


<h3 class="mb-3">
    Итоговая таблица центробежных насосов
</h3>


@if (!string.IsNullOrWhiteSpace(SaveMessage))
{
    <div class="alert alert-info py-2">
        @SaveMessage
    </div>
}


<div class="mb-2">
    <button class="btn btn-outline-secondary me-2"
            @onclick="SetColumnWidths">
        Выровнять столбцы
    </button>

    <button class="btn btn-primary"
            @onclick="LoadData">
        Обновить данные из БД
    </button>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <button class="btn btn-outline-primary"
            @onclick="SaveExcelToFolder">
        Сохранить Excel на сервере
    </button>

    <button class="btn btn-primary"
            @onclick="DownloadExcelAsync">
        Скачать Excel на ПК
    </button>

    <button class="btn btn-outline-success"
            @onclick="SaveContractExcel">
        Сохранить контракт на сервере
    </button>

    <button class="btn btn-success"
            @onclick="DownloadContractAsync">
        Скачать контракт
    </button>
</div>
<br/>


<!--    зазметка страницы              -->
<SfSpreadsheet @ref="Spreadsheet"
               Width="100%"
               Height="600px"
               
               AllowEditing="true"
               CellEditing="OnCellEditing"
               CellSaved="OnCellSaved">

    <SpreadsheetSheets>
        <SpreadsheetSheet Name="Sheet1">
        </SpreadsheetSheet>
    </SpreadsheetSheets>
    
</SfSpreadsheet>








