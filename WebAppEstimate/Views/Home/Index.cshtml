@{
    ViewData["Title"] = "Главная";
}

<div class="welcome-shipyard-container">
    <div class="welcome-box text-center">
        <!-- Декоративный элемент: силуэт якоря или штурвала -->
        <div class="nautical-badge">⚓</div>
        
        <h1 class="display-4 welcome-title">Diploma Project on Estimate</h1>
        <p class="welcome-subtitle">Система расчета и управления судоремонтными проектами</p>
        
        <hr class="welcome-divider" />
        
        <h5 class="welcome-info-text">Добро пожаловать. Используйте кнопку ниже для перехода в рабочие разделы системы.</h5>
        
        <!-- Главная стилизованная кнопка-рамка -->
        <div class="action-wrapper">
            <a class="enter-shipyard-btn" asp-area="" asp-controller="Start" asp-action="Start">
                <span class="btn-icon">🚢</span>
                <span class="btn-text">Войти в систему</span>
                <span class="btn-arrow">&rarr;</span>
            </a>
        </div>
    </div>
</div>